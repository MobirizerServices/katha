# --- Dev media: the generated HLS placeholder catalog (534MB) is regenerable, never committed
media/
*.mp4
*.m3u8
# NOTE: never ignore bare *.ts — HLS segments share the extension with
# TypeScript, and a global rule silently drops web source files. Segments
# only ever live under media/, which is ignored above.
media/**/*.ts

# --- Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# --- Node / web
node_modules/
.next/
out/
web/**/.env*

# --- Generated clients (regenerated from contracts/ in CI — never hand-edited, never committed)
ios/Generated/
web/**/src/api/generated/
backend/**/_generated/

# --- Swift
ios/**/.build/
ios/**/*.xcodeproj/xcuserdata/

# --- Secrets & env (never commit)
.env
.env.*
*.pem
*.p8
secrets/

# --- OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# --- Terraform
infra/**/.terraform/
*.tfstate
*.tfstate.*

# SQLite dev databases
*.db
*.db-journal

# Coverage output
coverage/
.nyc_output/
*.profdata
*.profraw
.coverage
*.tsbuildinfo

# Generated Xcode app project (regenerate: cd ios && ruby generate_xcodeproj.rb) + build output
ios/KathaApp.xcodeproj/
ios/build/
ios/build-device/

# Device screen-review captures (session artifacts, regenerable)
review/
