# --- Dev media: the generated HLS placeholder catalog (534MB) is regenerable, never committed
media/
*.mp4
*.m3u8
# NOTE: never ignore bare *.ts — HLS segments share the extension with
# TypeScript, and a global rule silently drops web source files. Segments
# only ever live under media/, which is ignored above.
media/**/*.ts

# --- Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# --- Node / web
node_modules/
.next/
out/
web/**/.env*

# --- Generated clients (regenerated from contracts/ in CI — never hand-edited, never committed)
ios/Generated/
web/**/src/api/generated/
backend/**/_generated/

# --- Swift
ios/**/.build/
ios/**/*.xcodeproj/xcuserdata/
# xcodebuild scratch (workspace + per-user UI state), not part of the generated project
ios/**/*.xcodeproj/project.xcworkspace/

# --- Secrets & env (never commit)
.env
.env.*
# the runbook template — placeholders only, never real values
!deploy/.env.qa.example
*.pem
*.p8
secrets/

# --- OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# --- Terraform
infra/**/.terraform/
*.tfstate
*.tfstate.*

# SQLite dev databases
*.db
*.db-journal

# Coverage output
coverage/
.nyc_output/
*.profdata
*.profraw
.coverage
*.tsbuildinfo

# Xcode app project is committed so a fresh clone can open and run the app.
# Regenerate it after adding/removing Swift files: cd ios && ruby generate_xcodeproj.rb
# Build output stays ignored.
ios/build/
ios/build-device/
ios/build-sim/
# Per-developer Debug overrides (LAN IP for a real device) — template is committed
ios/KathaApp/Config/Local.xcconfig

# Device screen-review captures (session artifacts, regenerable)
review/
