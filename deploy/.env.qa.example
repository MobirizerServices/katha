# Copy to .env at the repo root and fill in real values before `docker compose
# -f docker-compose.qa.yml up`. Both backends refuse to start (prodguard) if
# anything below is missing, left at a dev default, or would run login on a stub.

# --- data ---
POSTGRES_PASSWORD=change-me-strong-db-password

# --- core-api secrets (generate: openssl rand -hex 32) ---
KATHA_JWT_SECRET=change-me-64-hex-jwt-secret
KATHA_STREAM_SECRET=change-me-64-hex-stream-secret

# --- core-api login: must be real, never the dev stub ---
# OTP: msg91 | twilio (console is refused — it only logs the code)
KATHA_OTP_PROVIDER=msg91
KATHA_MSG91_KEY=
KATHA_MSG91_TEMPLATE=
KATHA_TWILIO_SID=
KATHA_TWILIO_TOKEN=
KATHA_TWILIO_SERVICE=
# Sign in with Apple: the audience of the identity token (app bundle id;
# add the Services ID comma-separated if the web site signs in too)
KATHA_APPLE_BUNDLE_ID=dev.katha.app

# --- admin-api ---
KATHA_ADMIN_SESSION_SECRET=change-me-64-hex-admin-session-secret
# The real OIDC relying-party config (Google Workspace, Okta…). All required:
# a blank issuer would select the built-in dev IdP, which is one click to any
# role, so prodguard refuses to boot without these.
KATHA_OIDC_ISSUER=https://accounts.google.com
KATHA_OIDC_CLIENT_ID=
KATHA_OIDC_CLIENT_SECRET=
KATHA_OIDC_REDIRECT_URL=https://admin-qa.katha.example/admin/v1/auth/callback
# Who may sign in before anyone is provisioned in the panel (email:role,…)
KATHA_ADMIN_USERS=you@your-workspace.example:admin
# VPN / office egress CIDRs (comma-separated). Mirror them in
# deploy/nginx/admin-allow.conf — the edge denies everything else.
KATHA_ADMIN_IP_ALLOWLIST=10.8.0.0/24

# --- origins (pin them; no wildcards) ---
KATHA_CORS_ORIGINS=https://qa.katha.example
PUBLIC_API_BASE=https://qa.katha.example
PUBLIC_ADMIN_ORIGIN=https://admin-qa.katha.example
PUBLIC_ADMIN_API_BASE=https://admin-qa.katha.example

# --- observability (optional but recommended in QA) ---
SENTRY_DSN=
